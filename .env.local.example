# Titunge — local development environment.
# Copy to .env.local and fill in. In production these are Cloudflare Worker
# secrets (wrangler secret put <NAME>). See README.md for what each one does.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Root domain for subdomain routing (optional, defaults to titunge.com)
# NEXT_PUBLIC_APP_DOMAIN=titunge.com

# Email via Resend (needed for invites)
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Titunge <invites@titunge.com>"

# Lenco payments (needed for marketplace checkout and payouts)
LENCO_API_SECRET_KEY=
LENCO_PAYOUT_ACCOUNT_ID=
LENCO_WEBHOOK_HASH_KEY=
LENCO_SANDBOX=true
NEXT_PUBLIC_LENCO_PUBLIC_KEY=
NEXT_PUBLIC_LENCO_SANDBOX=true

# Shared secret for /api/cron/* routes
CRON_SECRET=
